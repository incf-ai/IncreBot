    // Slash commands whose answers go into the history (discord/remember.rs;
    // persona::REMEMBERABLE lists them). Left out = none.
    remember_commands: [
        "ask",
        "hotdog-rater",
        "kobold-name",
        "lick-test",
        "roast",
        "fortune",
        "hoard-value",
        "kobold-age",
        "judge",
        "trap-check",
        "drink",
        "gamble",
        "dragon-alert",
        "vibe-check",
    ],
    // Users' names in lowercase in the prompt (labels, @mentions, command
    // prompts). Left out = as Discord shows them.
    lowercase_names: true,
    // Characters a chat reply can't start with (one each). Left out = none.
    // The bot's clock: each reply's note starts with the note for the time of
    // day there. utc_offset: whole hours from UTC, no daylight saving (-4 is
    // US Eastern in summer, -5 in winter). Each time runs from its hour
    // (local, 0-23) until the next one's. Left out = no time.
    clock: Clock {
        utc_offset: -4,
        times: [
            Time { from: 5,  note: "(it's dawn.)" },
            Time { from: 8,  note: "(it's morning.)" },
            Time { from: 12, note: "(it's afternoon.)" },
            Time { from: 17, note: "(it's evening.)" },
            Time { from: 21, note: "(it's sunset.)" },
            Time { from: 0,  note: "(it's night.)" },
        ],
    },
    // No Capitalized first word ("Oh" -> "oh"); all-caps shouting is fine.
    lowercase_start: true,
    banned_first_chars: ["!", "(", "[", "#", "{", ",", "/", "\\", "|", ";", "`", "$", "%", "&", ")", "-", "_", "+", "}", "]", "~", "\""],
}
