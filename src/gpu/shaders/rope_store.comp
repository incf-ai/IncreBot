#version 460
// RoPE on Q (in place) and K, and both K and V stored as f16 into the cache at
// positions pos0.. . One invocation per pair: first Q's pairs, then K's (rotated
// and stored), then V's (stored). Pairs are adjacent elements (2i, 2i + 1), or
// with NEOX the two halves of each head (i, i + head_dim / 2). With ROWS the
// cos/sin tables hold one row per token of this call rather than per position
// (Qwen3-VL's multimodal positions, which aren't the cache slots).
#include "common.glsl"

layout(local_size_x = 256) in;
layout(push_constant) uniform P {
    F32 q; F32 k; F32 v; F32 cos_; F32 sin_; F16 kc; F16 vc;
    uint t; uint heads; uint kv_heads; uint head_dim; uint pos0;
} p;

void main() {
    uint g = gl_GlobalInvocationID.x;
    uint half_ = p.head_dim / 2;
    uint qpairs = p.t * p.heads * half_, kpairs = p.t * p.kv_heads * half_;
    uint kvw = p.kv_heads * p.head_dim;
    if (g < qpairs + kpairs) {
        bool is_q = g < qpairs;
        uint pg = is_q ? g : g - qpairs;
        uint per_row = (is_q ? p.heads : p.kv_heads) * half_;
        uint row = pg / per_row, i = pg % half_;
#ifdef ROWS
        uint at_ = row * half_ + i;
#else
        uint at_ = (p.pos0 + row) * half_ + i;
#endif
        float c = p.cos_.v[at_];
        float s = p.sin_.v[at_];
#ifdef NEOX
        uint ia = (pg / half_) * p.head_dim + i, ib = ia + half_;
#else
        uint ia = 2 * pg, ib = 2 * pg + 1;
#endif
        F32 x = is_q ? p.q : p.k;
        float a = x.v[ia], b = x.v[ib];
        float ra = a * c - b * s, rb = a * s + b * c;
        if (is_q) {
            x.v[ia] = ra;
            x.v[ib] = rb;
        } else {
            uint at = p.pos0 * kvw;
            p.kc.v[at + ia] = float16_t(ra);
            p.kc.v[at + ib] = float16_t(rb);
        }
    } else if (g < qpairs + kpairs + kpairs) {
        uint pg = g - qpairs - kpairs;
        uint at = p.pos0 * kvw + 2 * pg;
        p.vc.v[at] = float16_t(p.v.v[2 * pg]);
        p.vc.v[at + 1] = float16_t(p.v.v[2 * pg + 1]);
    }
}
