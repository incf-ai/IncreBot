#version 460
// gate = silu(gate) · up, elementwise, in place.
#include "common.glsl"

layout(local_size_x = 256) in;
layout(push_constant) uniform P {
    F32 gate; F32 up;
    uint count;
} p;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.count) return;
    float g = p.gate.v[i];
    p.gate.v[i] = g / (1.0 + exp(-g)) * p.up.v[i];
}
