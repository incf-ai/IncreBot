#version 460
// y = (x − mean) / sqrt(var + eps) · w + b over each row, one workgroup per row.
#include "common.glsl"

layout(local_size_x = 256) in;
layout(push_constant) uniform P {
    F32 x; F32 w; F32 b; F32 y;
    uint width; float eps;
} p;

void main() {
    uint row = gl_WorkGroupID.x, tid = gl_LocalInvocationID.x;
    uint base = row * p.width;
    float s = 0.0;
    for (uint i = tid; i < p.width; i += 256) s += p.x.v[base + i];
    float mean = workgroup_sum(s) / float(p.width);
    float ss = 0.0;
    for (uint i = tid; i < p.width; i += 256) {
        float v = p.x.v[base + i] - mean;
        ss += v * v;
    }
    float inv = 1.0 / sqrt(workgroup_sum(ss) / float(p.width) + p.eps);
    for (uint i = tid; i < p.width; i += 256) p.y.v[base + i] = (p.x.v[base + i] - mean) * inv * p.w.v[i] + p.b.v[i];
}
